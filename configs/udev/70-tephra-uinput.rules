# Tephra: lets the logged-in user create a virtual keyboard (/dev/uinput), which Tephra uses to
# press Esc for a game so the game pauses itself when you open the menu over it.
# Install: sudo cp 70-tephra-uinput.rules /etc/udev/rules.d/
#          echo uinput | sudo tee /etc/modules-load.d/tephra-uinput.conf
#          sudo modprobe uinput && sudo udevadm control --reload && sudo udevadm trigger --name-match=uinput
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
