# Tephra splash: navy background, shard logo.
# Boot: logo fades in, then breathes softly.
# Shutdown/reboot: logo holds, then logo and background fade to black.

mode = Plymouth.GetMode();
shutting_down = (mode == "shutdown" || mode == "reboot");

fun set_background(f) {
    Window.SetBackgroundTopColor(0.043 * f, 0.071 * f, 0.125 * f);
    Window.SetBackgroundBottomColor(0.027 * f, 0.043 * f, 0.071 * f);
}
set_background(1);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

if (shutting_down) {
    logo.sprite.SetOpacity(1);
} else {
    logo.sprite.SetOpacity(0);
}

frame = 0;
fun refresh_callback() {
    frame++;
    if (shutting_down) {
        if (frame < 50) {
            logo.sprite.SetOpacity(1);
        } else if (frame < 125) {
            f = 1 - (frame - 50) / 75;
            logo.sprite.SetOpacity(f);
            set_background(f);
        } else {
            logo.sprite.SetOpacity(0);
            set_background(0);
        }
    } else {
        if (frame < 75) {
            logo.sprite.SetOpacity(frame / 75);
        } else {
            logo.sprite.SetOpacity(0.85 + 0.15 * Math.Cos((frame - 75) / 40));
        }
    }
}
Plymouth.SetRefreshFunction(refresh_callback);
