# Tephra boot splash: navy background, shard logo fades in, then breathes softly.
Window.SetBackgroundTopColor(0.043, 0.071, 0.125);
Window.SetBackgroundBottomColor(0.027, 0.043, 0.071);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0);

frame = 0;
fun refresh_callback() {
    frame++;
    if (frame < 75) {
        logo.sprite.SetOpacity(frame / 75);
    } else {
        logo.sprite.SetOpacity(0.85 + 0.15 * Math.Cos((frame - 75) / 40));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);
